# Copy to .env at the repo root; both apps/web and apps/worker read it locally.

# Postgres (e.g. Neon). Run `pnpm db:push` once to create the tables.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# One Google OAuth client (type "Web application") serves both logins.
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/bot/callback
# (plus the same two paths on your production domain)
# Enable the Google Calendar API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts bot refresh tokens at rest. Must be identical in web and worker.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- web only ---
# npx auth secret
AUTH_SECRET=

# --- worker only ---
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
# LIVE_NOTES_MODEL=gemini-2.5-flash
# REPORT_MODEL=gemini-2.5-flash
# BOT_DISPLAY_NAME=Notetaker        # name shown when joining as a guest
# BOT_HEADLESS=true                 # false = visible browser (useful for debugging)
# BOT_PROFILES_DIR=./.bot-profiles  # signed-in Chrome profiles from `pnpm bot:login`
# MAX_CONCURRENT_BOTS=3
# WORKER_ID=worker-1                # stable id so a restarted worker recovers its meetings
